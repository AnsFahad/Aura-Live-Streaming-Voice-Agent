# ==========================================
# Aura: Live Streaming Voice Agent Configuration
# ==========================================

# 1. Deepgram Streaming ASR
# Get $200 free credit at https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# 2. Llama 3 via Groq (Ultra-fast LLM inference, 300+ tokens/sec, free tier available)
# Get free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant
LLM_API_BASE=https://api.groq.com/openai/v1

# 3. Cartesia AI Streaming Sonic TTS (Ultra-low latency speech synthesis)
# Sign up at https://play.cartesia.ai
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091

# Server Settings
HOST=0.0.0.0
PORT=8000
MAX_CONCURRENT_SESSIONS=100

# Force simulation/mock mode for testing without external API keys (true/false)
FORCE_MOCK=false
